        "tags": [
          "Metadata"
        ],
        "summary": "Listado de barrios disponibles con su slug y nombre",
        "operationId": "list_neighborhoods_api_v1_neighborhoods_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response List Neighborhoods Api V1 Neighborhoods Get"
                }
              }
            }
          }
        }
      }
    },
