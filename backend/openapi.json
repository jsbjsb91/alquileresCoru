      "get": {
        "tags": [
          "System"
        ],
        "summary": "Estado de salud de la API y versión del modelo",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/neighborhoods": {
